{
  "name": "codemetrics-ai",
  "version": "0.5.0",
  "description": "Deterministic code metrics and scorecard evidence for JavaScript, TypeScript, and React projects",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codemetrics-ai": "./dist/cli.js",
    "codemetrics-evidence": "./dist/evidence-cli.js",
    "codemetrics-python": "./dist/python-cli.js"
  },
  "files": [
    "dist",
    "!dist/**/__pycache__/**",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/copy-source-facts.mjs && tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "prepack": "npm run build",
    "test": "npm run build && vitest run --maxWorkers=2",
    "test:package": "node scripts/package-smoke.mjs",
    "test:architecture": "npm run build && node scripts/architecture-corpus.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/semver": "7.8.0",
    "vitest": "^3.2.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "semver": "7.8.5",
    "typescript": "5.8.3",
    "yaml": "2.9.1"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#source-facts/*": "./dist/shared-source-facts/*"
  }
}
